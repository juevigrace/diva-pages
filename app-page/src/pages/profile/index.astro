---
import AppLayout from '@layouts/AppLayout.astro';
import ProfileForms from '@components/app/ProfileForms';
import { apiFetch } from '@api/lib/fetch';
import { t } from '@lib/i18n/t';
import { API_BASE_URL } from 'astro:env/server';
import type { SessionResponse } from 'diva-types/auth/responses/session';

const { user, state, profile: cachedProfile } = Astro.locals;
const auth = await Astro.session.get<SessionResponse>('auth');

let profile: Record<string, any> | null = cachedProfile;

if (state?.verified && user) {
  try {
    const profileRes = await apiFetch(`/api/user/${user.id}/profile`, { token: auth!.access_token });
    if (profileRes.ok) {
      profile = profileRes.json.data;
    }
  } catch (_) {}
}

const isVerified = !!state?.verified;
const avatarUrl = profile?.avatar ? `${API_BASE_URL}${profile.avatar}` : undefined;
---

<AppLayout
  title={t('page.profile.title', Astro.locals.lang)}
  heading={t('nav.profile', Astro.locals.lang)}
  description={t('page.profile.desc', Astro.locals.lang)}
>
  {user && <ProfileForms uid={user.id} user={user} profile={profile} avatarUrl={avatarUrl} isVerified={isVerified} lang={Astro.locals.lang} client:load />}
</AppLayout>
