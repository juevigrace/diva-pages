---
import AppLayout from '@layouts/AppLayout.astro';
import EndpointPermissionsManager from '@components/app/EndpointPermissionsManager';
import { apiFetch } from '@api/lib/fetch';
import { t } from '@lib/i18n/t';
import type { SessionResponse } from 'diva-types/auth/responses/session';

const { user, state } = Astro.locals;
const auth = await Astro.session.get<SessionResponse>('auth');

const url = new URL(Astro.request.url);
const currentPage = parseInt(url.searchParams.get('page') || '1', 10);
const limit = 20;

let rowsData: Record<string, any>[] = [];
let totalItems = 0;
let totalPages = 1;
let loadError = false;
let allPermissions: Record<string, any>[] = [];
let currentUserRole = user?.role || '';

if (state?.verified && user) {
  try {
    const res = await apiFetch(`/api/endpoint-permissions/?page=${currentPage}&limit=${limit}`, { token: auth!.access_token });
    if (res.ok) {
      rowsData = res.json.data?.items || [];
      totalItems = res.json.data?.pagination_info?.total_items || 0;
      totalPages = res.json.data?.pagination_info?.total_pages || 1;
    } else {
      loadError = true;
    }
    const permRes = await apiFetch(`/api/permissions/?page=1&limit=100`, { token: auth!.access_token });
    if (permRes.ok) {
      allPermissions = permRes.json.data?.items || [];
    }
  } catch (_) {
    loadError = true;
  }
}

const isVerified = !!state?.verified;
---

<AppLayout
  title={t('page.endpointPermissions.title', Astro.locals.lang)}
  heading={t('nav.endpointPermissions', Astro.locals.lang)}
  description={t('page.endpointPermissions.desc', Astro.locals.lang)}
>
  <EndpointPermissionsManager
    initialRows={rowsData}
    initialPage={currentPage}
    initialTotalPages={totalPages}
    initialTotalItems={totalItems}
    allPermissions={allPermissions}
    loadError={loadError}
    currentUserRole={currentUserRole}
    isVerified={isVerified}
    lang={Astro.locals.lang}
    client:load
  />
</AppLayout>
